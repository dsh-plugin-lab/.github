{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Turned off explicitly: nothing is emitted under `noEmit` anyway, but the parent config has
    // `declaration` and `sourceMap` on, and a reader would assume tests produce them.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Tests import the source under test with an explicit `.ts` extension (vitest resolves it through
    // Vite, verified working). Without this, `tsc -p tsconfig.test.json` reports TS5097 outright.
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "test/**/*"],
  // `src/client/**` is excluded from the **root files** only; its compilation entry point is
  // tsconfig.client.json. When a test imports it, it still joins the program.
  "exclude": ["src/client"]
}
