{
  "name": "{{name}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "author": "{{author}}",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{owner}}/{{name}}.git"
  },
  "bugs": {
    "url": "https://github.com/{{owner}}/{{name}}/issues"
  },
  "homepage": "https://github.com/{{owner}}/{{name}}#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"{{clientExport}}
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "{{dshRange}}"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }{{dshClient}}
  },
  "scripts": {
    "build": "{{buildScript}}",
    "typecheck": "{{typecheckScript}}",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"{{clientPeerDeps}}
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"{{clientDevDeps}}{{builderDeps}}
  }
}
