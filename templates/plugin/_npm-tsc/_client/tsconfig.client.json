{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The browser half imports its own files with explicit `.ts` / `.tsx` extensions (both vitest and
    // the bundler accept that). Note it is only legal under `emitDeclarationOnly` / `noEmit`, and
    // this project is the former.
    "allowImportingTsExtensions": true,
    "types": [],
    "outDir": "./lib/types",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/client/**/*"],
  "exclude": []
}
